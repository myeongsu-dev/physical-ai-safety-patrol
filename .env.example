# 복사해서 .env로 쓰고, .env는 커밋하지 않는다

# Pi 5 (edge)
ROBOT_ID=A                 # A · B · C · D
DOG_PORT=/dev/ttyACM0      # MechDog 보드 USB 시리얼
CAM_PORT=/dev/ttyACM1      # XIAO ESP32-S3 머리 카메라
SERVER_URL=http://192.168.0.10:8000   # 관제 서버 (사진 올리기)

# MQTT (edge · server 공통)
MQTT_HOST=192.168.0.10
MQTT_PORT=1883
