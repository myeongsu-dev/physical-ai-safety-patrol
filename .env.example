# 복사해서 .env로 쓰고, .env는 커밋하지 않는다

# Pi 5 (edge)
ROBOT_ID=A                 # A · B · C · D
# 포트 이름은 PC·Pi·꽂는 순서마다 다름. python -m edge.hwcheck ports로 찾아 자기 값으로 바꾼다 (Windows는 COM 번호)
DOG_PORT=/dev/ttyUSB0      # MechDog 보드 (CH340 칩이라 ttyUSB)
CAM_PORT=/dev/ttyACM0      # XIAO ESP32-S3 머리 카메라 (칩 내장 USB라 ttyACM)
VISION_PORT=/dev/ttyUSB1   # 바닥 비전 모듈 USB (firmware/vision 굽기·영상 보기). 평소에는 안 꽂아도 됨
SERVER_URL=http://192.168.0.10:8000   # 관제 서버 (사진 올리기)

# MQTT (edge · server 공통)
MQTT_HOST=192.168.0.10
MQTT_PORT=1883
